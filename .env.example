# Copy this file to .env.local and fill it in. Never commit .env.local.

# Password for the dashboard at /admin (required). Use a long passphrase.
ADMIN_PASSWORD=change-me-to-a-long-passphrase

# Optional: random string used to sign the login cookie. If empty, a key is derived from the password.
SESSION_SECRET=

# Optional: folder where enquiries are stored. Defaults to ./data/store
DATA_DIR=
